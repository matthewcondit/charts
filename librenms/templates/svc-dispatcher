{{- if .Values.dispatcher.enabled }}
apiVersion: v1
kind: Service
metadata:
  name: librenms-dispatcher
  namespace: {{ .Release.Namespace }}
  labels:
    app: librenms-dispatcher
spec:
  type: {{ .Values.dispatcher.service.type }}
  ports:
    - port: {{ .Values.dispatcher.service.port }}
      targetPort: {{ .Values.dispatcher.service.port }}
      protocol: TCP
  selector:
    app: librenms-dispatcher
{{- end }}
